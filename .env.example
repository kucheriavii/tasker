# PostgreSQL connection (used in Docker or standalone Postgres)
DATABASE_URL=postgresql://tasker:tasker_secret_password@localhost:5432/tasker

# Admin password for library and status management (default: admin)
ADMIN_PASSWORD=admin

# AI task breakdown and curriculum generation (Google Gemini API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Port (default: 3000)
PORT=3000
